# Copy to `.env` and adjust. Loaded by docker compose (`make up`) and can be sourced for local runs.
# `.env` is gitignored; this example is committed.

# --- Application ---
APP_NAME=silpo-restock-ai
SERVER_PORT=8080

# --- Database (shared by the `db` and `app` compose services) ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
# Host port to expose PostgreSQL on (container port stays 5432).
DB_PORT=5432

# --- Silpo MCP (https://mcp.silpo.ua/mcp) ---
# Public OAuth 2.1 client id from Dynamic Client Registration. Not a secret — Silpo issues public
# clients with no client_secret. Leave blank and the app registers itself on first use, logging the
# id it received. This one is already registered for the redirect URI below.
SILPO_MCP_CLIENT_ID=AOJkhCwfQQJ5CVTl
SILPO_MCP_REDIRECT_URI=http://localhost:8080/auth/silpo/callback
# Base64 of 32 random bytes, encrypting OAuth tokens at rest. Generate your own and keep it out of git:
#   openssl rand -base64 32
# Unset means an ephemeral key: the app boots, but stored tokens die with the process.
SILPO_TOKEN_ENCRYPTION_KEY=

# --- Telegram ---
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL of the webhook, e.g. https://<subdomain>.ngrok-free.app/telegram/webhook
# Leave blank to skip webhook registration at startup.
TELEGRAM_WEBHOOK_URL=
# Shared secret Telegram echoes back in X-Telegram-Bot-Api-Secret-Token. Generate with:
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# --- Anthropic Claude ---
# API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional overrides; the defaults in application.yml are usually right.
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MAX_TOKENS=4096
# Only needed for an identity-linked key (one tied to a person, not a workspace). Such a key is rejected
# with "anthropic-workspace-id is required"; find the id in the console URL under Settings > Workspaces.
# ANTHROPIC_WORKSPACE_ID=

# --- Speech to text (voice check-ins) ---
# Any OpenAI-compatible /v1/audio/transcriptions endpoint. Leave blank to disable voice check-ins:
# the bot then asks the user to type instead, and everything else keeps working.
STT_API_KEY=
# Optional overrides; the defaults in application.yml point at OpenAI's whisper-1 in Ukrainian.
# STT_ENDPOINT=https://api.groq.com/openai/v1/audio/transcriptions
# STT_MODEL=whisper-large-v3
# STT_LANGUAGE=uk

# --- Google Calendar (optional) ---
# A confirmed delivery slot becomes a calendar event for users who ran /calendar and consented.
# Leave blank to disable: /calendar says the feature is off and ordering is unaffected.
# Create a Web application OAuth client at https://console.cloud.google.com/apis/credentials and add
# http://localhost:8080/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_EVENT_DURATION=2h

# --- Respeecher (optional spoken replies) ---
# Text-to-speech only: voice check-ins are still transcribed by STT_* above. Blank disables spoken
# replies deployment-wide; per chat they stay off until someone sends /voice.
# Get a Space API key from the playground at https://space.respeecher.com
RESPEECHER_API_KEY=
# Optional overrides. ua-rt is the Ukrainian model and the only one supporting explicit stress marks.
# RESPEECHER_MODEL=ua-rt
# RESPEECHER_VOICE_ID=samantha
